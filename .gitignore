__pycache__/
*.py[cod]
.pytest_cache/
.venv/
logs/
paper/*.aux
paper/*.log
paper/*.out

# Track D stage-1 run artifacts.
# Transient stdout: the same content is written to per-arm curves.csv and to
# reports/trackD_stage1_results.json, which ARE tracked.
results_stage1.log
# Model checkpoints: ~6 MB each, regenerable from the recorded config + seeds.
# The scientific record (curves, metrics, per-trial rows) is tracked instead.
results/track_d/stage1/*/checkpoint.pt
results/track_d/stage1/*/best.pt

# Track D stage-3 (HS-URformer) run artifacts.
# The EM-GS feature cache is 123 MB of DERIVED data: a deterministic function
# of (S, Z, B, sigma2, seed, T_GS) with a bit-exact regeneration path and a
# test that pins it (test_emgs_cache_is_bit_exact). Never a scientific record.
results/track_d/emgs_cache/
# Per-epoch weights exist only so the one-SE selection rule can promote the
# chosen epoch to best.pt; after that they are dead weight (~6 MB x 13 x 2).
# Stage 2 tracked its own, which is why .git is already 362 MB -- not a
# precedent worth extending. The selection input (val_per_trial.npy), the
# curves, best.pt and the per-trial test rows ARE tracked.
results/track_d/stage3/*/ep[0-9][0-9][0-9].pt
results/track_d/stage3/*/checkpoint.pt

# Track D stage-4 (gated Hankel + [5,20] probe) run artifacts. Same rule as
# stage 3: per-epoch weights exist only so the one-SE rule can promote the
# chosen epoch to best.pt, after which they are dead weight.
results/track_d/stage4/*/ep[0-9][0-9][0-9].pt
results/track_d/stage4/*/checkpoint.pt

# Per-operating-point sweep shards: raw per-trial numerator/denominator, one
# file per (SNR, P). The merged curves are tracked as
# reports/trackD_sweep_curves.json and the figures alongside them.
results/track_d/sweeps/*.json
