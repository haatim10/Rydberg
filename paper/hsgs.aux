\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces NMSE versus SNR at $N=32$, $P=30$, RSR $=12$~dB. EM-GS is indistinguishable from the unconstrained CRLB across the range, so the bound is tight for the unstructured problem. HS-GS lies between the two bounds, recovering part of the structural headroom identified by the geometric CCRB.}}{4}{}\protected@file@percent }
\newlabel{fig:snr}{{1}{4}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Paired HS-GS gain over EM-GS versus array size. Faint markers are the six individual SNR operating points; solid lines are their mean. The gain grows monotonically with $N$; at $N=8$ the individual points straddle zero, so no single scalar summarises that array size.}}{4}{}\protected@file@percent }
\newlabel{fig:scaling}{{2}{4}{}{}{}}
